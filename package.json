{
  "name": "lithos-launcher",
  "productName": "Lithos Launcher",
  "version": "0.2.1-twobit.3",
  "description": "One-click installer and runner for the Ergo node and Lithos Client",
  "license": "CC0-1.0",
  "author": "Lithos Protocol",
  "homepage": "https://github.com/Lithos-Protocol/Lithos-Launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lithos-Protocol/Lithos-Launcher.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/main/*.test.ts",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons": "electron scripts/make-icons.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tar": "^7.5.22",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "yauzl": "^3.4.0"
  }
}
